{
  "name": "@workspace/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "import-csv": "tsx scripts/import-csv.ts",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "format": "prettier --write \"**/*.ts\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts",
    "./csv": "./src/csv/index.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "latest",
    "@types/node": "^22",
    "dotenv": "^17",
    "eslint": "^10",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vitest": "5.0.5"
  }
}
